{
  "name": "@codellyson/justui",
  "version": "0.3.0",
  "description": "Shared design system for the just* app family — theme tokens, six dev themes (GitHub, Espresso, Catppuccin Mocha, Gruvbox, Nord, Solarized) and six consumer themes (Sunset, Ocean, Bloom, Meadow, Grape, Mono), a no-flash boot script, and per-framework component adapters (Astro + React).",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "rm -rf dist",
    "prepack": "pnpm run clean && pnpm run build"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./boot": {
      "types": "./dist/theme-boot.d.ts",
      "default": "./dist/theme-boot.js"
    },
    "./themes": {
      "types": "./dist/theme-plugins.d.ts",
      "default": "./dist/theme-plugins.js"
    },
    "./tokens.css": "./src/styles/tokens.css",
    "./tailwind-preset": {
      "types": "./src/tailwind-preset.d.cts",
      "default": "./src/tailwind-preset.cjs"
    },
    "./astro/Button.astro": "./src/astro/Button.astro",
    "./astro/ThemeToggle.astro": "./src/astro/ThemeToggle.astro",
    "./react": {
      "types": "./dist/react/index.d.ts",
      "default": "./dist/react/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src/styles",
    "src/astro",
    "src/tailwind-preset.cjs",
    "src/tailwind-preset.d.cts",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "astro": "^5.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "tailwindcss": "^3.4.0 || ^4.0.0"
  },
  "peerDependenciesMeta": {
    "astro": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "tailwindcss": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "react": "^19.0.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2"
  },
  "keywords": [
    "design-system",
    "theme",
    "tailwind",
    "astro",
    "react",
    "tauri",
    "just-ui"
  ],
  "homepage": "https://github.com/codellyson/justui#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/codellyson/justui.git"
  }
}
