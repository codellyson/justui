{
  "name": "@codellyson/justui",
  "version": "1.0.0",
  "description": "Design system for the just* app family — theme tokens, twelve themes, a no-flash boot script, ~50 React components on Radix, Astro adapters, and a Tailwind v4 design config.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "prepack": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc",
    "playground": "pnpm run build && vite --config playground/vite.config.ts",
    "playground:build": "pnpm run build && vite build --config playground/vite.config.ts",
    "check:icons": "node scripts/check-icons.mjs",
    "lint": "tsc --noEmit && node scripts/check-icons.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./boot": {
      "types": "./dist/theme-boot.d.ts",
      "default": "./dist/theme-boot.js"
    },
    "./themes": {
      "types": "./dist/theme-plugins.d.ts",
      "default": "./dist/theme-plugins.js"
    },
    "./tokens.css": "./src/styles/tokens.css",
    "./astro/Button.astro": "./src/astro/Button.astro",
    "./astro/ThemeToggle.astro": "./src/astro/ThemeToggle.astro",
    "./react": {
      "types": "./dist/react/index.d.ts",
      "default": "./dist/react/index.js"
    },
    "./package.json": "./package.json",
    "./tailwind.css": "./src/styles/tailwind.css"
  },
  "files": [
    "dist",
    "src/styles",
    "src/astro",
    "README.md",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-checkbox": "^1.1.0",
    "@radix-ui/react-collapsible": "^1.1.20",
    "@radix-ui/react-dialog": "^1.1.0",
    "@radix-ui/react-dropdown-menu": "^2.1.0",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-radio-group": "^1.4.7",
    "@radix-ui/react-select": "^2.1.0",
    "@radix-ui/react-slider": "^1.4.7",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-switch": "^1.1.0",
    "@radix-ui/react-tabs": "^1.1.0",
    "@radix-ui/react-toggle-group": "^1.1.19",
    "@radix-ui/react-tooltip": "^1.1.0",
    "@tanstack/react-table": "^8.21.3",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "react-dropzone": "^20.0.0",
    "tailwind-merge": "^2.5.0"
  },
  "peerDependencies": {
    "@heroicons/react": "^2.0.0",
    "astro": "^5.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "tailwindcss": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "astro": {
      "optional": true
    },
    "tailwindcss": {
      "optional": true
    }
  },
  "devDependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@heroicons/react": "^2.2.0",
    "@mdx-js/react": "^3.1.1",
    "@mdx-js/rollup": "^3.1.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/mdx": "^2.0.14",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "autoprefixer": "^10.5.4",
    "postcss": "^8.5.26",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-live": "^4.1.8",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.2",
    "unist-util-visit": "^5.1.0",
    "vite": "^8.2.1"
  },
  "keywords": [
    "design-system",
    "theme",
    "tailwind",
    "astro",
    "react",
    "tauri",
    "just-ui"
  ],
  "homepage": "https://github.com/codellyson/justui#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/codellyson/justui.git"
  }
}
